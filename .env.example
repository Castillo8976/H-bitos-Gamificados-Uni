# StudyQuest — variables de entorno de ejemplo (sin secretos).
# Copia este archivo a .env (ignorado por Git), cambia los valores y cárgalo antes de iniciar:
#   set -a; source .env; set +a; npm start

# Servidor y base de datos
PORT=3000
# Interfaz de escucha: 127.0.0.1 (solo este equipo). Usa 0.0.0.0 solo si debe verse en la red local.
HOST=127.0.0.1
# Ruta del archivo SQLite; por defecto ./database.sqlite en la raíz del proyecto.
DATABASE_STORAGE=./database.sqlite
SQLITE_BUSY_TIMEOUT_MS=5000 # Espera por bloqueo SQLite en milisegundos; 0 desactiva la espera.
# NODE_ENV=production exige JWT_SECRET y, si se activa el correo, SMTP y AUTH_CODE_SECRET.
NODE_ENV=development

# Autenticación. En producción define un secreto largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Verificación de correo y segundo paso (opcional, desactivado por defecto).
AUTH_EMAIL_VERIFICATION=false
AUTH_EMAIL_MFA=off
# memoria = captura los mensajes sin enviarlos (solo desarrollo y pruebas); smtp = proveedor real.
MAIL_TRANSPORT=memoria
AUTH_CODE_SECRET=
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_MAX_RESENDS=3
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60

# Proveedor SMTP (solo si MAIL_TRANSPORT=smtp). No guardes credenciales reales en el repositorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Migración automática al arrancar (no recomendado): por defecto el servidor se detiene si la base
# existente requiere migraciones y pide ejecutar npm run db:migrate tras hacer un respaldo.
# STUDYQUEST_AUTO_MIGRATE=false
